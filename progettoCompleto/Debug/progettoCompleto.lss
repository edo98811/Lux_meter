                                 ;
                                 ;
                                 .CSEG
                                 .ORG 0x0000							; definisce l'inizio del codice all'indirizzo 0x0000 (obbligatorio)			 
                                 ;
                                 ; INTERRUPT VECTORS FOLLOW
                                 ;
000000 940c 0034                  	jmp RESET 				; vector 1:		Reset Handler
000002 940c 0099                 	jmp EXT_INT0			; vector 2:		IRQ0 Handler
000004 940c 009a                 	jmp EXT_INT1			; vector 3:		IRQ1 Handler
000006 940c 009b                 	jmp PCINTR0				; vector 4:		PCINT0 Handler
000008 940c 009c                 	jmp PCINTR1				; vector 5:		PCINT1 Handler
00000a 940c 009d                 	jmp PCINTR2				; vector 6:		PCINT2 Handler
00000c 940c 009e                 	jmp WDT					; vector 7:		Watchdog timer handler
00000e 940c 009f                 	jmp TIM2_COMPA			; vector 8:		Timer2 Compare A handler
000010 940c 00a0                 	jmp TIM2_COMPB			; vector 9:		Timer2 compare B handler
000012 940c 00a1                 	jmp TIM2_OVF			; vector 10:	Timer2 Overflow Handler
000014 940c 00a2                 	jmp TIM1_CAPT			; vector 11:	Timer1 Capture Handler
000016 940c 00a3                 	jmp TIM1_COMPA			; vector 12:	Timer1 CompareA Handler
000018 940c 00a4                 	jmp TIM1_COMPB			; vector 13:	Timer1 CompareB Handler
00001a 940c 00a5                 	jmp TIM1_OVF			; vector 14:	Timer1 Overflow Handler
00001c 940c 00a6                 	jmp TIM0_COMPA			; vector 15:	Timer 0 CompareA handler
00001e 940c 00a7                 	jmp TIM0_COMPB			; vector 16:	Timer 0 CompareB handler
000020 940c 00a8                 	jmp TIM0_OVF 			; vector 17:	Timer0 Overflow Handler
000022 940c 00b2                 	jmp SPI_STC				; vector 18:	SPI Transfer Complete Handler
000024 940c 00b3                 	jmp USART_RXC			; vector 19:	USART RX Complete Handler
000026 940c 00b4                 	jmp USART_UDRE			; vector 20:	USART UDR Empty Handler
000028 940c 00b5                 	jmp USART_TXC			; vector 21:	USART TX Complete Handler
00002a 940c 00b6                 	jmp ADC_conv			; vector 22:	ADC Conversion Complete Handler
00002c 940c 00b7                 	jmp EE_RDY				; vector 23:	EEPROM Ready Handler
00002e 940c 00b8                 	jmp ANA_COMP			; vector 24:	Analog Comparator Handler
000030 940c 00b9                 	jmp TWSI				; vector 25:	Two-wire Serial Interface Handler
000032 940c 00ba                 	jmp SPM_RDY				; vector 26:	Store Program Memory Ready Handler
                                 ;
                                 ; END OF INTERRUPT VECTORS 
                                 ;
                                 RESET:
                                 ; In questo punto inizia il programma principale
                                 ;
                                 ; Inizializzazione dello stack pointer all'ultima cella della RAM
                                 ;
000034 e008                      	ldi     mp,HIGH(RAMEND)
000035 bf0e                         	out     SPH,mp
000036 ef0f                         	ldi     mp,LOW(RAMEND)
000037 bf0d                         	out     SPL,mp
                                 ;
                                 ; Inizializzazione in uscita dei primi 7 bit della porta D. PD0 - PD3 = ABCD; PD4 = LE centinaia; PD5 = LE decine; PD6 = LE unità.
                                 
000038 e70f                      	ldi	mp,0b0111_1111
000039 b90a                      	out	DDRD,mp
                                 ;
00003a e700                      	ldi	mp, 0b0111_0000			; mette a 1 i LE dei 4511 (condizione di memoria)
00003b b90b                      	out	PORTD, mp						
                                 ;
                                 ; divide per 16 la frequenza del clock interno (16 MHz)
00003c e800                      	ldi	mp, 0b1000_0000
00003d 9300 0061                 	sts	CLKPR, mp				; abilita la programmazione del prescaler
00003f e004                      	ldi	mp, 0b0000_0100
000040 9300 0061                 	sts	CLKPR, mp				; programma la divisione per 16 del clock interno
                                 ;
                                 ;	programma il timer 0
                                 ;
                                 ; seleziona prescaler passo 1024 (se 1 MHz allora 1024 us)
000042 e005                      	ldi     mp,0b0000_0101
000043 bd05                         	out     TCCR0B,mp
                                 ;	seleziona tempo tra interrupt pari a circa 10ms (10,24 ms)
000044 ef06                      	ldi     mp, 246
000045 bd06                         	out     TCNT0,mp
                                 ;	abilita l'interrupt in caso di overflow di TCNT0
000046 e001                      	ldi     mp,0b0000_0001
000047 9300 006e                 	sts     TIMSK0,mp
                                 ;
                                 ; inizializza la variabile var_check che sarà decrementata dalla subroutine di risposta ad interrupt 
                                 ;
000049 e322                      	ldi		var_check,T_CHECK
                                 ;
                                 ;   programma l'ADC in modo da abilitarlo senza abilitare l'interrupt e seleziona un fattore di prescaling pari a 4.
                                 ;   Deve SEMPRE precedere la selezione dell'ingresso: non si può selezionare l'ingresso dell'ADC se questo non è stato preventivamente abilitato
00004a e802                      	ldi 	mp,0b10000010
00004b 9300 007a                 	sts		ADCSRA,mp
                                 ;
                                 ;	programma l'ADC perché lavori con riferimento interno pari alla tensione di alimentazione (AVcc), giustifichi a sinistra il risultato e senta l'input su PC0 (ADC0)
                                 ;
00004d e600                      	ldi		mp,0b0110_0000
00004e 9300 007c                 	sts		ADMUX,mp
                                 ;
                                 ;
                                 ; abilita gli interrupt a livello di SREG
                                 ;
000050 9478                      	sei
                                 ;
                                 ;
                                 main_loop:
                                 ;
                                 ;	verifica se è trascorso un tempo pari all'intervallo di campionamento della tensione (var_check = 0?)
                                 ;
000051 3020                      	cpi		var_check,0
                                 ;
                                 ;   salto condizionato a end_loop se var_check è diverso da 0
                                 ;	
000052 f439                      	brne	end_loop
                                 ; 
                                 ;   le istruzioni da qui a rjmp main_loop vengono eseguite solo se var_check è pari a 0
                                 ;
000053 e322                      	ldi		var_check,T_CHECK		; per prima cosa inizializza nuovamente var_check
                                 ;
                                 ;	prepara il passaggio dell'indirizzo iniziale della tabella alla subroutine come variabile locale nello stack
                                 ;
000054 e3ff                      	ldi		ZH,high(2*tabella)		; inizializza ZH con la parte alta dell'indirizzo della tabella
000055 efee                      	ldi		ZL,low(2*tabella)		; inizializza ZL con la parte bassa dell'indirizzo della tabella
                                 ;									
000056 93ff                      	push	ZH				; mette ZH nello stack per passarlo alla subroutine che lo utilizzerà come parametro
                                 ;
000057 93ef                      	push	ZL				; mette ZL nello stack per passarlo alla subroutine che lo utilizzerà come parametro
                                 ;
                                 ; richiamo della subroutine measure che campiona la tensione e visualizza il risultato (attenzione, la call memorizza nello stack i due byte dell'indirizzo di rientro)
                                 ;
000058 940e 005c                 	call	measure
                                 ;
                                 end_loop:
                                 ;
00005a 0000                      	nop						; istruzione di comodo aggiunta per il debugging (nop = no operation), aggiunge un ritardo di un ciclo di clock
                                 ;
00005b cff5                             rjmp main_loop
                                 ;
                                 ;	Segue la subroutine che legge l'uscita dell'ADC e mostra il valore letto su 8 bit sulle tre lampade a sette segmenti
                                 ;   Riceve come parametri passati dal programma chiamante nello stack i byte basso ed alto dell'indirizzo iniziale della LUT
                                 ;
                                 measure:
                                 ;
00005c 910f                      	pop		mp		; estrae temporaneamente dallo stack l'ultimo byte dell'indirizzo di rientro messo nello stack dalla call
00005d 911f                      	pop		mp1		; estrare temporaneamente dallo stack il primo byte dell'indirizzo di rientro messo nello stack dalla call
00005e 91ef                      	pop		ZL		; recupera il byte basso dell'indirizzo  della tabella che è stato passato dal programma chiamante nello stack
00005f 91ff                      	pop		ZH		; recupera il byte alto dell'indirizzo della tabella che è stato passato dal programma chiamante nello stack
000060 931f                      	push	mp1		; ripristina nello stack il primo byte dell'indirizzo di rientro messo nello stack dalla call
000061 930f                      	push	mp		; ripristina nello stack l'ultimo byte dell'indirizzo di rientro messo nello stack dalla call
                                 ;
                                 ;	inizia adesso la conversione portando a 1 il bit 6 di ADCSRA (ADSC) senza modificare null'altro in ADCSRA
                                 ;
000062 9100 007a                 	lds		mp,ADCSRA
000064 e410                      	ldi		mp1,0b0100_0000
000065 2b01                      	or		mp,mp1
000066 9300 007a                 	sts		ADCSRA,mp
                                 ;
                                 ; aspetta che la conversione sia pronta testando ADSC in ADCSRA: a conversione terminata ADSC torna a 0 
                                 ;
                                 check_conv:
000068 9100 007a                 	lds		mp,ADCSRA
00006a e410                      	ldi		mp1,0b01000000
00006b 2301                      	and		mp,mp1
00006c f7d9                      	brne	check_conv
                                 ;
                                 ;
                                 ; legge il valore convertito su 8 bit (siccome è stata scelta la giustificazione a sinistra gli 8 bit più significativi 
                                 ; del risultato sono in ADCH)
                                 ;
                                 ;
00006d 9100 0079                 	lds		mp,ADCH
00006f e014                      	ldi		mp1,4
000070 9f01                      	mul		mp,mp1
                                 ;
000071 0de0                      	add		ZL,R0		; Punta alla cella della tabella che corrisponde al valore letto dall'ADC
000072 1df1                      	adc		ZH,R1
                                 ;
                                 ;	prepara visulaizzazione su display
                                 ;
000073 9105                      	lpm		mp, Z+		; legge primo valore della riga della tabella che contiene il valore completo intero su 8 bit ed incrementa Z
                                 ;
000074 9105                      	lpm		mp, Z+		; legge il secondo valore della riga della tabella che contiene la cifra delle centinaia  ed incrementa Z
000075 6700                      	ori		mp,0b0111_0000	; lascia a uno PD4 - PD7	e non modifica PD0 - PD3	
000076 b90b                      	out		PORTD, mp		; scrive in uscita la cifra delle centinaia
000077 760f                      	andi	mp, 0b0110_1111	; prepara PD4 a livello basso (LE centinaia) senza modificare la cifra delle centinaia
000078 b90b                      	out		PORTD, mp		; abilita LE centinaia
000079 0000                      	nop					; istruzioni di attesa necessarie per garantire l'efficacia dello strobe
00007a 0000                      	nop
00007b 0000                      	nop
00007c 0000                      	nop
00007d 0000                      	nop
00007e 6700                      	ori		mp,0b0111_0000	; mette a uno PD4 - PD7 (alza LE)
00007f b90b                      	out		PORTD, mp
                                 ;		
                                 ;
000080 9105                      	lpm		mp, Z+			; legge il terzo valore della riga della tabella che contiene la cifra delle decine  ed incrementa Z
                                 ;
000081 6700                      	ori		mp,0b0111_0000	; lascia a 1  PD4 - PD7		e non modifica PD0 - PD3
000082 b90b                      	out		PORTD, mp		; scrive in uscita la cifra delle decine
000083 750f                      	andi	mp, 0b0101_1111		; prepara PD5 a livello basso (LE decine) senza modificare la cifra delle decine
000084 b90b                      	out		PORTD, mp		; abilita LE decine
000085 0000                      	nop					; istruzioni di attesa necessarie per garantire l'efficacia dello strobe
000086 0000                      	nop
000087 0000                      	nop
000088 0000                      	nop
000089 0000                      	nop
00008a 6700                      	ori		mp,0b0111_0000	; mette a uno PD4 - PD7 (alza LE)
00008b b90b                      	out		PORTD, mp	
                                 ;
00008c 9105                      	lpm		mp, Z+			; legge il quarto valore della riga della tabella che contiene la cifra delle unità  ed incrementa Z
                                 ;
00008d 6700                      	ori		mp,0b0111_0000	; lascia a 1  PD4 - PD7		e non modifica PD0 - PD3		
00008e b90b                      	out		PORTD, mp		; scrive in uscita la cifra delle unità
00008f 730f                      	andi	mp, 0b0011_1111	; prepara PD6 a livello basso (LE unità) senza modificare la cifra delle unità
000090 b90b                      	out		PORTD, mp		; abilita LE unità
000091 0000                      	nop					; istruzioni di attesa necessarie per garantire l'efficacia dello strobe
000092 0000                      	nop
000093 0000                      	nop
000094 0000                      	nop
000095 0000                      	nop
000096 6700                      	ori		mp,0b0111_0000	; mette a uno PD4 - PD7 (alza LE)
